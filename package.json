{
  "name": "her-voice-desktop-agent",
  "productName": "Her",
  "version": "0.1.0",
  "private": true,
  "description": "Local GPT Realtime voice assistant for controlled desktop, copy, mail, and calendar workflows.",
  "author": "Her contributors",
  "main": "electron/dist/main/main.js",
  "scripts": {
    "patch:electron-plist": "node scripts/patch-electron-plist.mjs",
    "predev": "npm run patch:electron-plist && node scripts/check-dev-port.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on http://127.0.0.1:5174 electron/dist/main/main.js && HER_RENDERER_DEV_URL=http://127.0.0.1:5174 electron electron/dist/main/main.js\"",
    "build": "tsc --noEmit && tsc -p electron/tsconfig.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:commands": "vitest run tests/command-fixtures.test.ts --reporter verbose",
    "test:intent-cards": "node scripts/simple-command-intent-report.mjs",
    "test:desktop:s1": "tsc -p electron/tsconfig.json && node scripts/simple-command-s1-desktop-report.mjs",
    "test:files:s2": "tsc -p electron/tsconfig.json && node scripts/simple-command-s2-files-report.mjs",
    "test:browser:s3": "tsc -p electron/tsconfig.json && node scripts/simple-command-s3-browser-report.mjs",
    "test:media:s4": "tsc -p electron/tsconfig.json && node scripts/simple-command-s4-media-report.mjs",
    "test:system:s5": "tsc -p electron/tsconfig.json && node scripts/simple-command-s5-system-report.mjs",
    "test:productivity:s6": "tsc -p electron/tsconfig.json && node scripts/simple-command-s6-productivity-report.mjs",
    "test:tasks:s7": "tsc -p electron/tsconfig.json && node scripts/simple-command-s7-task-shell-report.mjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepackage": "npm run build",
    "package": "electron-forge package",
    "premake": "npm run build",
    "make": "electron-forge make",
    "prepublish": "npm run build",
    "publish": "electron-forge publish",
    "prestart": "npm run patch:electron-plist",
    "start": "electron electron/dist/main/main.js",
    "monitor": "node scripts/monitor-audit.mjs --follow",
    "monitor:summary": "node scripts/monitor-audit.mjs --summary",
    "smoke:tools": "tsc -p electron/tsconfig.json && node scripts/smoke-tool-routing.mjs",
    "smoke:realtime-intent": "tsc -p electron/tsconfig.json && node scripts/smoke-realtime-intent-parser.mjs",
    "smoke:complex": "tsc -p electron/tsconfig.json && node scripts/smoke-complex-intents.mjs",
    "smoke:broad": "HER_COMPLEX_SMOKE_PROFILE=broad tsc -p electron/tsconfig.json && HER_COMPLEX_SMOKE_PROFILE=broad node scripts/smoke-complex-intents.mjs",
    "smoke:voice": "HER_COMPLEX_SMOKE_PROFILE=voice tsc -p electron/tsconfig.json && HER_COMPLEX_SMOKE_PROFILE=voice node scripts/smoke-complex-intents.mjs",
    "smoke:semantic": "HER_COMPLEX_SMOKE_PROFILE=semantic tsc -p electron/tsconfig.json && HER_COMPLEX_SMOKE_PROFILE=semantic node scripts/smoke-complex-intents.mjs",
    "smoke:ux": "tsc -p electron/tsconfig.json && node scripts/smoke-ux-flows.mjs",
    "smoke:m2": "tsc -p electron/tsconfig.json && node scripts/smoke-m2-manifest-policy.mjs",
    "smoke:m3": "tsc -p electron/tsconfig.json && node scripts/smoke-m3-realtime-bundles.mjs",
    "smoke:m4": "tsc -p electron/tsconfig.json && node scripts/smoke-m4-coding-agent.mjs",
    "smoke:m4-5": "tsc -p electron/tsconfig.json && node scripts/smoke-m4-5-task-runtime.mjs",
    "smoke:realtime": "node scripts/smoke-realtime-token.mjs"
  },
  "dependencies": {
    "@openai/agents": "^0.11.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "three": "^0.184.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.2",
    "electron": "^42.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.1"
  }
}

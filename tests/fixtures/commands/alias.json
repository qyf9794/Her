        "toolName": "app_open",
        "arguments": {
          "appName": "Shadowrocket"
        }
      },
      "risk": "local_write",
      "requiresConfirmation": true
    }
  },
  {
    "id": "alias.run.vpn.zh.001",
    "utterance": "打开 VPN",
    "locale": "zh-CN",
    "category": "alias",
    "strictness": "strict",
    "preconditions": [
      {
        "alias": {
          "phrase": "打开 VPN",
          "toolName": "app_open",
          "arguments": {
            "appName": "Shadowrocket"
          }
        }
      }
    ],
    "expected": {
      "aliasMatched": true,
      "bundles": [
        "desktop"
      ],
      "tool": "app_open",
      "args": {
        "appName": "Shadowrocket"
      },
      "risk": "local_open",
      "requiresConfirmation": false
    }
  },

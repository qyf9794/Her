    "utterance": "以后我说打开 VPN，就是打开 Shadowrocket",
    "locale": "zh-CN",
    "category": "alias",
    "strictness": "strict",
    "expected": {
      "bundles": [
        "core"
      ],
      "tool": "alias_create",
